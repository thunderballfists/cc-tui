<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cc-tui.archive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__INSTALL_DIR__/cc-tui-archive-sync.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.claude/cc-tui-archive.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/cc-tui-archive.log</string>
</dict>
</plist>
